# FORGE — orchestration for local/Docker deployment.
# Copy this file to `.env` and fill in the values you want to enable.

# ------------------------------------------------------------------ secrets
# Optional: if set, every write API endpoint requires this bearer token.
FORGE_API_TOKEN=
# Requests per minute per client (write + read API).
FORGE_API_RATE_LIMIT=60

# ---------------------------------------------------------- generative repair
# Enables the AI repair layer (off by default to keep things deterministic).
FORGE_LLM_ENABLED=true
# Any OpenAI-compatible provider works. Free option: OpenRouter with a :free model.
FORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
FORGE_LLM_API_KEY=
FORGE_LLM_MODEL=cohere/north-mini-code:free
# Automatic fallback when the primary provider is unreachable (no key needed).
FORGE_LLM_FALLBACK_URL=https://text.pollinations.ai/openai
FORGE_LLM_FALLBACK_MODEL=openai
FORGE_LLM_TIMEOUT_S=90
FORGE_LLM_MAX_FILES=3
FORGE_LLM_MAX_FILE_BYTES=80000

# -------------------------------------------------------- learning (skills)
# Record a playbook for every bug FORGE fixes with AI, so repeat defects are
# handled deterministically without the LLM.
FORGE_SKILL_LEARNING=true

# --------------------------------------------------------------- GitHub PR
# To open pull requests from fixed missions. Token needs "repo" scope.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main